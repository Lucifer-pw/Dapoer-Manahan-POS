rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Izinkan pembacaan publik untuk foto menu & QRIS
      allow read: if true;
      // Hanya staf/admin yang terotentikasi yang bisa upload dan hapus gambar
      allow write: if request.auth != null;
    }
  }
}
